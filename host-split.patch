diff --git a/ios/src/perf_ios.mm b/ios/src/perf_ios.mm
new file mode 100644
index 0000000..35aaaa4
--- /dev/null
+++ b/ios/src/perf_ios.mm
@@ -0,0 +1,274 @@
+// Writes the measurements of cemu_shims/botw_perf.h every 5 s from a low-priority thread, one folder per run, in
+// <Documents>/perf/<date-time>/: frames.csv, spikes.csv (each long frame and what held it up), threads.csv (CPU time by
+// thread name) and meta.txt. perf/perf_report.py reads them. <Documents>/botw_tune.txt chooses the level: perf=full,
+// frames or off. A file <Documents>/botw_perf_off still turns it off, as in v5.
+#ifdef BOTW_SPLIT_HOST
+#import <Foundation/Foundation.h>
+#import <UIKit/UIKit.h>
+#include <mach/mach.h>
+#include <mach/thread_info.h>
+#include <os/proc.h>
+#include <pthread.h>
+#include <sys/sysctl.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <atomic>
+#include <cstdio>
+#include <map>
+#include <mutex>
+#include <string>
+#include <thread>
+
+#include "../../runtime/cemu_shims/botw_perf.h"
+#include "../../runtime/cemu_shims/botw_tune.h"
+#include "split_ios.h"
+
+extern float g_render_scale;
+namespace threads {
+std::string stall_snapshot(bool stacks);
+std::string main_wait_report();
+}
+std::string botw_lock_report(double t_s);
+
+namespace {
+constexpr int kWindowSeconds = 5;
+constexpr int kRunsKept = 20;
+
+std::mutex g_meta_lock;
+FILE* g_meta = nullptr;
+std::atomic<uint64_t> g_memory_warnings{0};
+
+void meta_line(const std::string& line) {
+    std::lock_guard<std::mutex> l(g_meta_lock);
+    if (!g_meta) return;
+    fprintf(g_meta, "%s\n", line.c_str());
+    fflush(g_meta);
+}
+
+std::string clock_text(const char* format) {
+    const time_t now = time(nullptr);
+    struct tm parts = {};
+    localtime_r(&now, &parts);
+    char text[32];
+    strftime(text, sizeof text, format, &parts);
+    return text;
+}
+
+std::string sysctl_text(const char* name) {
+    char value[128] = {};
+    size_t size = sizeof value - 1;
+    return sysctlbyname(name, value, &size, nullptr, 0) == 0 ? value : "?";
+}
+
+// What one Scoped costs here, on this low-priority thread, so a little more than on the threads it measures.
+double scope_cost_ns() {
+    constexpr int kRounds = 200000;
+    botw_perf::g_enabled.store(true, std::memory_order_relaxed);
+    botw_perf::Counter counter;
+    const uint64_t begin = botw_perf::now_ns();
+    for (int i = 0; i < kRounds; i++) botw_perf::Scoped scope(counter);
+    return (double)(botw_perf::now_ns() - begin) / kRounds;
+}
+
+struct ThreadTime {
+    uint64_t cpu_ns;
+    int priority;
+    int threads;
+};
+
+// CPU time by thread name since the last call, for threads.csv. Threads sharing a name are added together.
+void write_threads(FILE* out, double t_s, std::map<uint64_t, uint64_t>& seen_ns) {
+    thread_act_array_t list = nullptr;
+    mach_msg_type_number_t count = 0;
+    if (task_threads(mach_task_self(), &list, &count) != KERN_SUCCESS) return;
+    std::map<std::string, ThreadTime> names;
+    std::map<uint64_t, uint64_t> now_ns;
+    for (mach_msg_type_number_t i = 0; i < count; i++) {
+        thread_extended_info_data_t info = {};
+        mach_msg_type_number_t info_count = THREAD_EXTENDED_INFO_COUNT;
+        thread_identifier_info_data_t id = {};
+        mach_msg_type_number_t id_count = THREAD_IDENTIFIER_INFO_COUNT;
+        if (thread_info(list[i], THREAD_EXTENDED_INFO, (thread_info_t)&info, &info_count) == KERN_SUCCESS &&
+            thread_info(list[i], THREAD_IDENTIFIER_INFO, (thread_info_t)&id, &id_count) == KERN_SUCCESS) {
+            const uint64_t cpu = info.pth_user_time + info.pth_system_time;
+            now_ns[id.thread_id] = cpu;
+            const auto before = seen_ns.find(id.thread_id);
+            ThreadTime& slot = names[info.pth_name[0] ? std::string(info.pth_name) : std::string("unnamed")];
+            slot.cpu_ns += cpu - (before == seen_ns.end() ? 0 : before->second);
+            slot.priority = info.pth_curpri;
+            slot.threads++;
+        }
+        mach_port_deallocate(mach_task_self(), list[i]);
+    }
+    vm_deallocate(mach_task_self(), (vm_address_t)list, count * sizeof(thread_act_t));
+    seen_ns.swap(now_ns);
+    for (const auto& entry : names)
+        if (entry.second.cpu_ns >= 1000000) fprintf(out, "%.0f,%s,%d,%d,%.1f\n", t_s, entry.first.c_str(), entry.second.threads, entry.second.priority, entry.second.cpu_ns / 1e6);
+    fflush(out);
+}
+
+struct Files {
+    FILE* frames;
+    FILE* spikes;
+    FILE* threads;
+    FILE* waits;
+    FILE* locks;
+};
+
+void write_loop(Files files, bool full) {
+    pthread_set_qos_class_self_np(QOS_CLASS_UTILITY, 0);
+    pthread_setname_np("botw_perf");
+    meta_line("scope_cost_ns=" + std::to_string(scope_cost_ns()));
+    botw_perf::g_enabled.store(full, std::memory_order_relaxed);
+    botw_perf::g_frames_on.store(true, std::memory_order_relaxed);
+    fprintf(files.frames, "%s,footprint_mb,available_mb,compressed_mb,faults,pageins,csw,mem_warnings,thermal,low_power,clock,hist,phist\n", botw_perf::kHeader);
+    fprintf(files.spikes, "%s\n", botw_perf::kSpikeHeader);
+    fprintf(files.threads, "t_s,name,threads,priority,cpu_ms\n");
+    fprintf(files.waits, "t_s,main_waits\n");
+    fprintf(files.locks, "t_s,kind,name,klock_ms,mutex_ms,ops,contended,holder\n");
+    fflush(files.waits);
+    fflush(files.locks);
+    fflush(files.frames);
+    fflush(files.spikes);
+    fflush(files.threads);
+    const uint64_t begin = botw_perf::now_ns();
+    uint64_t last = begin;
+    std::map<uint64_t, uint64_t> thread_ns;
+    task_events_info_data_t events_before = {};
+    bool scale_noted = false;
+    for (;;) {
+        sleep(kWindowSeconds);
+        const uint64_t now = botw_perf::now_ns();
+        const double t_s = (now - begin) / 1e9;
+        static char line[2048], hist[1024], present_hist[1024];
+        const int n = botw_perf::write_window(line, sizeof line, t_s, (now - last) / 1e9, hist, sizeof hist, present_hist, sizeof present_hist);
+        last = now;
+        task_vm_info_data_t vm = {};
+        mach_msg_type_number_t count = TASK_VM_INFO_COUNT;
+        const bool ok = task_info(mach_task_self(), TASK_VM_INFO, (task_info_t)&vm, &count) == KERN_SUCCESS;
+        task_events_info_data_t events = {};
+        count = TASK_EVENTS_INFO_COUNT;
+        const bool events_ok = task_info(mach_task_self(), TASK_EVENTS_INFO, (task_info_t)&events, &count) == KERN_SUCCESS;
+        NSProcessInfo* process = NSProcessInfo.processInfo;
+        fprintf(files.frames, "%.*s,%llu,%llu,%llu,%d,%d,%d,%llu,%d,%d,%s,%s,%s\n", n, line, ok ? (unsigned long long)(vm.phys_footprint >> 20) : 0, (unsigned long long)(os_proc_available_memory() >> 20),
+                ok ? (unsigned long long)(vm.compressed >> 20) : 0, events_ok ? events.faults - events_before.faults : 0, events_ok ? events.pageins - events_before.pageins : 0, events_ok ? events.csw - events_before.csw : 0,
+                (unsigned long long)g_memory_warnings.exchange(0, std::memory_order_relaxed), (int)process.thermalState, process.lowPowerModeEnabled ? 1 : 0, clock_text("%H:%M:%S").c_str(), hist, present_hist);
+        fflush(files.frames);
+        if (events_ok) events_before = events;
+        botw_perf::Spike spike;
+        while (botw_perf::next_spike(spike)) {
+            botw_perf::write_spike(line, sizeof line, spike, begin);
+            fprintf(files.spikes, "%s\n", line);
+        }
+        fflush(files.spikes);
+        write_threads(files.threads, t_s, thread_ns);
+        if (full) {
+            std::string waits = threads::main_wait_report();
+            for (char& c : waits)
+                if (c == ',') c = ';';
+            fprintf(files.waits, "%.0f,%s\n", t_s, waits.c_str());
+            fflush(files.waits);
+        }
+        if (botw_perf::g_locks_on.load(std::memory_order_relaxed)) {
+            fputs(botw_lock_report(t_s).c_str(), files.locks);
+            fflush(files.locks);
+        }
+        if (!scale_noted && g_render_scale > 0) {
+            scale_noted = true;
+            meta_line("render_scale=" + std::to_string(g_render_scale));
+        }
+    }
+}
+
+// diag_stall_ms: when the render thread has ended no frame for that long, notes once what the threads are doing, in
+// stalls.csv. diag_stall_stacks=1 also logs the host stacks of main, AX and the render thread, at most every 20 s.
+void stall_loop(FILE* out, uint64_t limit_ns, bool stacks) {
+    pthread_set_qos_class_self_np(QOS_CLASS_USER_INTERACTIVE, 0);
+    pthread_setname_np("botw_stall");
+    fprintf(out, "t_ns,clock,waited_ms,took_us,state\n");
+    uint64_t noted_frame = 0, last_stacks = 0;
+    for (;;) {
+        usleep(5000);
+        const uint64_t last = botw_perf::g_last_frame_ns.load(std::memory_order_relaxed), now = botw_perf::now_ns();
+        if (!last || last == noted_frame || botw_perf::g_paused.load(std::memory_order_relaxed) || now < last + limit_ns) continue;
+        noted_frame = last;
+        const bool with_stacks = stacks && now >= last_stacks + 20000000000ull;
+        if (with_stacks) last_stacks = now;
+        const std::string state = threads::stall_snapshot(with_stacks);
+        fprintf(out, "%llu,%s,%llu,%llu,%s\n", (unsigned long long)now, clock_text("%H:%M:%S").c_str(), (unsigned long long)((now - last) / 1000000), (unsigned long long)((botw_perf::now_ns() - now) / 1000), state.c_str());
+        fflush(out);
+    }
+}
+
+std::string read_text(const std::string& path) {
+    std::string text;
+    if (FILE* f = fopen(path.c_str(), "r")) {
+        char chunk[1024];
+        size_t got;
+        while ((got = fread(chunk, 1, sizeof chunk, f)) > 0) text.append(chunk, got);
+        fclose(f);
+    }
+    return text;
+}
+
+// The older runs' folders, oldest first by their names, which are dates. Nothing else in Documents is ever touched.
+void remove_old_runs(NSString* runs) {
+    NSFileManager* files = NSFileManager.defaultManager;
+    NSArray<NSString*>* names = [[files contentsOfDirectoryAtPath:runs error:nil] sortedArrayUsingSelector:@selector(compare:)];
+    NSMutableArray<NSString*>* dated = [NSMutableArray array];
+    NSPredicate* format = [NSPredicate predicateWithFormat:@"SELF MATCHES %@", @"[0-9]{8}-[0-9]{6}"];
+    for (NSString* name in names)
+        if ([format evaluateWithObject:name]) [dated addObject:name];
+    for (NSInteger i = 0; i + kRunsKept < (NSInteger)dated.count; i++) [files removeItemAtPath:[runs stringByAppendingPathComponent:dated[i]] error:nil];
+}
+}  // namespace
+
+void botw_perf_note(const char* line) { meta_line(line); }
+
+void botw_perf_start(const char* docs) {
+    const std::string folder = docs;
+    const botw_tune::Parsed tune = botw_tune::parse(read_text(folder + "/botw_tune.txt"));
+    // After repeated failed starts, no experiment runs: a setting can then never lock the game out, nor call for a new install.
+    const bool safe = botw_boot_safe_mode();
+    if (!safe) botw_tune::current() = tune;
+    const std::string level = botw_tune::text(tune, "perf", "full");
+    if (level == "off" || access((folder + "/botw_perf_off").c_str(), F_OK) == 0) return;
+
+    NSString* runs = [@(docs) stringByAppendingPathComponent:@"perf"];
+    NSString* run = [runs stringByAppendingPathComponent:@(clock_text("%Y%m%d-%H%M%S").c_str())];
+    if (![NSFileManager.defaultManager createDirectoryAtPath:run withIntermediateDirectories:YES attributes:nil error:nil]) return;
+    remove_old_runs(runs);
+    const std::string path = run.UTF8String;
+    Files files = {fopen((path + "/frames.csv").c_str(), "w"), fopen((path + "/spikes.csv").c_str(), "w"), fopen((path + "/threads.csv").c_str(), "w"), fopen((path + "/main_waits.csv").c_str(), "w"), fopen((path + "/locks.csv").c_str(), "w")};
+    g_meta = fopen((path + "/meta.txt").c_str(), "w");
+    if (!files.frames || !files.spikes || !files.threads || !files.waits || !files.locks || !g_meta) return;
+
+    const bool full = level != "frames";
+    meta_line(std::string("version=") + botw_perf::kVersion);
+    meta_line("level=" + std::string(full ? "full" : "frames"));
+    meta_line("started=" + clock_text("%Y-%m-%d %H:%M:%S"));
+    meta_line("model=" + sysctl_text("hw.machine"));
+    meta_line("os=" + std::string(UIDevice.currentDevice.systemVersion.UTF8String));
+    meta_line("cores=" + std::to_string(NSProcessInfo.processInfo.activeProcessorCount));
+    meta_line("screen_max_fps=" + std::to_string((long)UIScreen.mainScreen.maximumFramesPerSecond));
+    for (const auto& entry : tune.values) meta_line("tune." + entry.first + "=" + entry.second);
+    for (const std::string& bad : tune.bad_lines) meta_line("tune_unreadable=" + bad);
+    for (const auto& entry : tune.values)
+        if (!botw_tune::known(entry.first)) meta_line("tune_unknown=" + entry.first);
+    if (safe) meta_line("experiments_ignored=safe_mode");
+
+    [NSNotificationCenter.defaultCenter addObserverForName:UIApplicationDidReceiveMemoryWarningNotification object:nil queue:nil usingBlock:^(NSNotification*) {
+        g_memory_warnings.fetch_add(1, std::memory_order_relaxed);
+    }];
+    botw_perf::g_spike_ns.store((uint64_t)botw_tune::integer(tune, "spike_ms", 25, 17, 1000) * 1000000, std::memory_order_relaxed);
+    // The audio device opens during the start and registers its request callback only if this is already true; the
+    // writer thread sets the final level after its calibration, which needs it on too.
+    botw_perf::g_enabled.store(full, std::memory_order_relaxed);
+    botw_perf::g_locks_on.store(full && botw_tune::enabled("diag_locks"), std::memory_order_relaxed);
+    std::thread(write_loop, files, full).detach();
+    if (const long stall_ms = botw_tune::integer(botw_tune::current(), "diag_stall_ms", 0, 0, 1000)) {
+        if (FILE* stalls = fopen((path + "/stalls.csv").c_str(), "w")) std::thread(stall_loop, stalls, (uint64_t)stall_ms * 1000000, botw_tune::enabled("diag_stall_stacks")).detach();
+    }
+}
+#endif
