diff --git a/runtime/src/game/native_duo.cpp b/runtime/src/game/native_duo.cpp
new file mode 100644
index 0000000..8eda9dd
--- /dev/null
+++ b/runtime/src/game/native_duo.cpp
@@ -0,0 +1,121 @@
+#include "native_duo.h"
+
+#include <CommonCrypto/CommonDigest.h>
+
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <iterator>
+#include <memory>
+#include <new>
+
+#include "hooks.h"
+#include "../log.h"
+#include "../mem.h"
+
+namespace native_duo {
+namespace {
+std::atomic<bool> g_active{false};
+constexpr char kV208Sha256[] = "ba58da5b95ce929e005d058ceb08b9b2788d1ab2bbc8a6c189bbadca0bb34d30";
+
+struct Word {
+    uint32_t addr;
+    uint32_t expected;
+};
+
+constexpr Word kCodeWords[] = {
+    {0x02e2c564, 0xec0b0028},  // fsubs f0,f11,f0
+    {0x02e2c578, 0xec806024},  // fdivs f4,f0,f12
+    {0x0386d01c, 0xed8d0028},  // fsubs f12,f13,f0
+    {0x0386d020, 0xed8b6024},  // fdivs f12,f11,f12
+    {0x035b0a30, 0x3ca0102f},  // lis r5, relocated grass-culling constant
+    {0x035b0a38, 0xc16594d8},  // lfs f11,-27432(r5)
+};
+
+constexpr Word kAspectWords[] = {
+    {0x101bf8e8, 0x3fe374bc},  // 1.777f in the original v208 image
+    {0x1030a57c, 0x3fe38e39},  // 16:9
+    {0x1036dd4c, 0x3fe38e39},  // 16:9
+};
+
+bool sha256(const std::string& path, char out[65]) {
+    FILE* f = fopen(path.c_str(), "rb");
+    if (!f) return false;
+    CC_SHA256_CTX ctx;
+    CC_SHA256_Init(&ctx);
+    constexpr size_t kBufferSize = 1024 * 1024;
+    std::unique_ptr<unsigned char[]> buf(new (std::nothrow) unsigned char[kBufferSize]);
+    if (!buf) {
+        fclose(f);
+        return false;
+    }
+    while (size_t n = fread(buf.get(), 1, kBufferSize, f)) CC_SHA256_Update(&ctx, buf.get(), (CC_LONG)n);
+    bool ok = !ferror(f);
+    fclose(f);
+    if (!ok) return false;
+    unsigned char digest[CC_SHA256_DIGEST_LENGTH];
+    CC_SHA256_Final(digest, &ctx);
+    for (size_t i = 0; i < sizeof digest; i++) snprintf(out + i * 2, 3, "%02x", digest[i]);
+    out[64] = 0;
+    return true;
+}
+
+bool validate_words(const Word* words, size_t count, const char* kind) {
+    for (size_t i = 0; i < count; i++) {
+        uint32_t got = mem::r32(words[i].addr);
+        if (got != words[i].expected) {
+            LOG("Native Duo: %s mismatch at %08x: expected %08x, got %08x; falling back to Fit",
+                kind, words[i].addr, words[i].expected, got);
+            return false;
+        }
+    }
+    return true;
+}
+}  // namespace
+
+bool configure(bool requested, const std::string& rpx_path) {
+    g_active = false;
+    if (!requested) {
+        LOG("Native Duo: disabled; using the original 16:9 path");
+        return true;
+    }
+    char digest[65];
+    if (!sha256(rpx_path, digest)) {
+        LOG("Native Duo: cannot hash %s; falling back to Fit", rpx_path.c_str());
+        return false;
+    }
+    if (strcmp(digest, kV208Sha256)) {
+        LOG("Native Duo: RPX SHA-256 mismatch: expected %s, got %s; falling back to Fit", kV208Sha256, digest);
+        return false;
+    }
+    if (!validate_words(kCodeWords, std::size(kCodeWords), "opcode") ||
+        !validate_words(kAspectWords, std::size(kAspectWords), "constant"))
+        return false;
+
+    // These are the three v208 aspect constants changed by Cemu's graphics pack. This only changes
+    // the already-loaded guest-memory image and never writes to U-King.rpx.
+    for (const Word& word : kAspectWords) mem::wf32(word.addr, kAspect);
+    g_active = true;
+    LOG("Native Duo: enabled for verified USA v208, aspect 317:223 (%.6f), render target %dx%d",
+        kAspect, kRenderWidth, kRenderHeight);
+    return true;
+}
+
+bool active() { return g_active.load(std::memory_order_relaxed); }
+
+// The original instructions calculate a 16:9 value. Hooks run immediately afterwards and replace
+// only the resulting FPR, which is equivalent to the small Cemu codecaves without modifying code.
+BOTW_EXPECT_OPCODE(0x02e2c564, 0xec0b0028)
+BOTW_HOOK_EXPECT(0x02e2c578, 0xec806024) {
+    if (active()) c->f[4] = kAspect;
+}
+
+BOTW_EXPECT_OPCODE(0x0386d01c, 0xed8d0028)
+BOTW_HOOK_EXPECT(0x0386d020, 0xed8b6024) {
+    if (active()) c->f[12] = kAspect;
+}
+
+BOTW_EXPECT_OPCODE(0x035b0a30, 0x3ca0102f)
+BOTW_HOOK_EXPECT(0x035b0a38, 0xc16594d8) {
+    if (active()) c->f[11] = kGameAspect / kAspect;
+}
+}  // namespace native_duo
