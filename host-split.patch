+    // only fits above it. With no game code in the app there is only the diagnostic to run.
+    const GuestLoad guest = botw_guest_load();
+    if (guest != GuestLoad::Game) {
+        const std::string summary = botw_diag_run(docs.UTF8String, guest);
+        const SDL_MessageBoxButtonData done[] = {{SDL_MESSAGEBOX_BUTTON_RETURNKEY_DEFAULT, 0, "OK"}};
+        const SDL_MessageBoxData box = {SDL_MESSAGEBOX_INFORMATION, nullptr, "BotW host diagnostic", summary.c_str(),
+                                        1, done, nullptr};
+        int pressed = 0;
+        SDL_ShowMessageBox(&box, &pressed);
+        return 0;
+    }
+#endif
