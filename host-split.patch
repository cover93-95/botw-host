+// The host built without generated/ (BOTW_SPLIT_HOST): loading Guest.framework, and the diagnostic.
+#pragma once
+#include <cstdint>
+#include <string>
+
+enum class GuestLoad {
+    None,     // no Guest.framework in the app
+    Failed,   // it is there and dlopen or a table failed: the reason is in botw_guest_error()
+    Fixture,  // the test framework, which holds no game code
+    Game,
+};
+
+GuestLoad botw_guest_load();
+const std::string& botw_guest_error();
+// Runs the fixture's round trip through the host. False when it failed; `out` says why.
+bool botw_guest_fixture_test(std::string& out);
+// Where the framework's code landed, and its size in memory. 0 when none is loaded.
+void botw_guest_image(uint64_t& base, uint64_t& size);
+
+// The first start's journal (bootlog.h). botw_boot_step is safe to call before botw_boot_begin.
+// Returns the arguments the runtime should add: a repeated failure asks less of the phone.
+std::string botw_boot_begin(const char* docs, const char* support);
+extern "C" void botw_boot_step(const char* name);
+bool botw_boot_safe_mode();
+void botw_boot_end();
+
+// Frame, compilation, GPU wait and audio measurements, written to <docs>/botw_perf.csv (perf_ios.mm).
+void botw_perf_start(const char* docs);
+
+// One line that keeps apart what is only reserved (virtual) from what iOS counts against the app (footprint).
+std::string botw_mem_line();
+// Writes <docs>/botw_diag.txt line by line, so a kill leaves the last step reached. Returns a short summary.
+std::string botw_diag_run(const char* docs, GuestLoad guest);
